{
  "name": "wesap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute wesap --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute wesap --local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute wesap --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute wesap --remote --file=./seed.sql",
    "db:migrate-incremental:local": "wrangler d1 execute wesap --local --file=./migrations/0001_add_customer_po_number.sql",
    "db:migrate-incremental:remote": "wrangler d1 execute wesap --remote --file=./migrations/0001_add_customer_po_number.sql",
    "db:migrate-supplier-ref:local": "wrangler d1 execute wesap --local --file=./migrations/0002_add_supplier_ref.sql",
    "db:migrate-supplier-ref:remote": "wrangler d1 execute wesap --remote --file=./migrations/0002_add_supplier_ref.sql",
    "seed:gen": "node scripts/gen-seed.mjs",
    "reset": "wrangler d1 execute wesap --remote --file reset.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.4",
    "hono": "^4.6.14",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.120.0"
  }
}
