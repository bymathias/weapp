{
  "name": "wesap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute wesap --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute wesap --local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute wesap --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute wesap --remote --file=./seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/zod-openapi": "^0.18.4",
    "@hono/swagger-ui": "^0.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "wrangler": "^4.120.0",
    "typescript": "^5.7.2",
    "@cloudflare/workers-types": "^5.20260801.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
}
